# Template only. Copy once:
#   cp .env.example .env
# Edit `.env` with your secrets. NEVER commit `.env`.
# Provider keys are read by the backend only and are never sent to the frontend.

# ---- Application ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ---- PostgreSQL / Supabase Postgres (durable state) ----
POSTGRES_USER=agentorch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=agentorch
POSTGRES_PORT=5432
# Host-based local runs use localhost. For Supabase, replace this with the Direct or
# Session Pooler URL from Dashboard > Connect and percent-encode reserved password chars.
DATABASE_URL=postgresql+asyncpg://agentorch:change-me-locally@localhost:5432/agentorch
# Docker runtime URL. Normal Compose runs against Supabase and does not start a local
# PostgreSQL service; paste the Supabase Direct or Session Pooler URL here.
# The e2e overlay supplies its own isolated local database URL for hermetic tests.
COMPOSE_DATABASE_URL=
# Local Postgres does not use TLS. Supabase should use require at minimum; production
# should use verify-full plus the project CA certificate downloaded from Database Settings.
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# ---- Redis (queues, cache, locks; NOT source of truth) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Frontend ----
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Browser-visible base URL. Must not contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Browser-visible canonical frontend origin, used for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase public browser configuration. Both must be set to enable Supabase Auth.
# The publishable key is intentionally public; never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side (container-to-container) base URL used by Next.js server components.
BACKEND_INTERNAL_URL=http://backend:8000

# ---- Auth ----
# supabase = require a Supabase access JWT (recommended in production)
# header = legacy/local operator (X-Operator-Id) + Agent Mesh Bearer sessions
# google = legacy direct-Google exchange retained during migration only
# off = DEV_OPERATOR_ID fallback (forbidden in production)
AUTH_MODE=header
DEV_OPERATOR_ID=operator
# Supabase backend JWT verification. Issuer/JWKS derive from SUPABASE_URL when blank.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy direct-Google settings. Supabase Auth stores the Google client ID/secret in
# its dashboard, so these can be removed after the legacy endpoints are retired.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Legacy Agent Mesh session lifetime; unused by AUTH_MODE=supabase.
SESSION_TTL_HOURS=12
# Directory for generated files. Not a public URL.
ARTIFACT_DIR=data/artifacts

# ---- Abuse protection ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis          # redis | memory
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Soft rolling spend cap per operator (USD). Leave empty for unlimited.
OPERATOR_BUDGET_USD=
OPERATOR_BUDGET_WINDOW_HOURS=24

# ---- CORS / hosts ----
CORS_ALLOW_ORIGINS=http://localhost:3000
# Production: comma-separated Host allow-list (no '*')
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- AI provider API keys (backend only; optional — also connectable in Settings) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
QWEN_API_KEY=
# Hugging Face Inference Providers (Hub token with Inference Providers permission).
# HF_TOKEN is also accepted as an alias.
HUGGINGFACE_API_KEY=

# Symmetric key for encrypting Settings-managed provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Development derives a fallback when unset.
ENCRYPTION_KEY=

# Legacy HS256 secret for Agent Mesh-issued sessions. It is not used by
# AUTH_MODE=supabase, where the API verifies Supabase's asymmetric access JWT.
# Required only while email/password or legacy direct-Google login remains enabled.
# Local/dev: leave blank and the API derives a stable fallback from DATABASE_URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional JWT claim checks (leave empty to skip):
JWT_AUDIENCE=
JWT_ISSUER=
